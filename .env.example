# Copy to .env and adjust.  `cp .env.example .env`

NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_DB=railcore
POSTGRES_USER=railcore
POSTGRES_PASSWORD=railcore
# 5432 is often taken by a locally installed PostgreSQL
POSTGRES_PORT=5433

# Used when running the API on your machine (npm run dev).
# In docker-compose this is overridden to point at the "db" service.
DB_URL=postgres://railcore:railcore@localhost:5433/railcore
DB_LOGGING=false
DB_SYNC_ALTER=false

# --- JWT ---
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=15m

# --- Email (used later for OTP verification) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
