{
  "name": "railcore",
  "version": "1.0.0",
  "description": "RailCore railway reservation & operations backend",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "nodemon --watch src --watch settings --ext ts --exec ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:up": "docker compose up -d db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.3.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6",
    "pg": "^8.16.3",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
